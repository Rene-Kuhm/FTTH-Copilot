{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["web", "worker", "migrations", "postgresql", "redis"],
  "properties": {
    "web": {
      "type": "object",
      "required": ["replicaCount", "image", "service"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount", "image", "service"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "hostNetwork": { "type": "boolean" },
        "service": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "externalTrafficPolicy": {
              "type": "string",
              "enum": ["", "Cluster", "Local"]
            },
            "snmpPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "syslogPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "redis": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
