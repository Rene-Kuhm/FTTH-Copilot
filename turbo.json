{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "PORT",
    "JWT_SECRET",
    "KMS_MASTER_KEY",
    "DEMO_MODE_ENABLED",
    "SMARTOLT_USE_MOCK",
    "SMARTOLT_API_BASE_URL",
    "SMARTOLT_API_KEY",
    "MIKROWISP_API_BASE_URL",
    "MIKROWISP_TOKEN",
    "NMS_ALLOWED_HOSTS",
    "NMS_ALLOWED_PORTS",
    "NMS_ALLOW_HTTP",
    "NMS_ALLOW_PRIVATE_NETWORKS",
    "NMS_REQUEST_TIMEOUT_MS",
    "METRICS_POLLER_ENABLED",
    "METRICS_POLL_INTERVAL_MS",
    "METRICS_RETENTION_DAYS",
    "ALERT_WEBHOOK_URL",
    "ALERT_COOLDOWN_MS",
    "ALERT_RESOLVE_AFTER_MS",
    "ALERT_ESCALATE_AFTER_MS",
    "FIRMWARE_AUDIT_ENABLED",
    "FIRMWARE_AUDIT_INTERVAL_MS",
    "FIRMWARE_AUDIT_VULNERABLE_LIST",
    "CHAT_RATE_LIMIT_PER_MINUTE",
    "CHAT_DAILY_QUOTA",
    "SYSLOG_RECEIVER_ENABLED",
    "SYSLOG_TENANT_ID",
    "SYSLOG_UDP_PORT",
    "SYSLOG_DETECTION_INTERVAL_MS",
    "SYSLOG_MAX_MESSAGE_LENGTH",
    "SYSLOG_MAX_EVENTS_PER_MINUTE",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "MINIMAX_API_KEY",
    "MINIMAX_BASE_URL",
    "MINIMAX_MODEL",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "DEEPSEEK_MODEL",
    "QWEN_API_KEY",
    "QWEN_BASE_URL",
    "QWEN_MODEL",
    "LLM_PROVIDER",
    "LLM_FALLBACK",
    "CLOUDFLARED_TOKEN",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@ftth-copilot/db#db:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "@ftth-copilot/db#db:generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build",
        "@ftth-copilot/db#db:generate"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": true,
      "outputs": [
        "src/generated/**"
      ]
    },
    "test:e2e": {
      "cache": false
    }
  }
}
