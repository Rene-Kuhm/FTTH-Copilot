{
  "name": "ftth-copilot",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Agente de IA sobre SmartOLT/Mikrowisp que da diagn\u00f3stico en lenguaje natural y reportes autom\u00e1ticos para ISPs.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @ftth-copilot/db db:generate",
    "db:generate": "pnpm --filter @ftth-copilot/db db:generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:unit": "turbo run test:unit",
    "test:coverage": "turbo run test:coverage",
    "test:coverage-check": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @ftth-copilot/web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.2"
  }
}
