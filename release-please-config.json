{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "include-commit-authors": true,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Performance" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build" },
    { "type": "ci", "section": "CI" },
    { "type": "chore", "section": "Maintenance" },
    { "type": "revert", "section": "Reverted" },
    { "type": "swarm", "section": "Changes" }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "ftth-copilot",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/agent-core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/alerts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/analytics/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/connectors/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/connectors/mikrotik/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/connectors/mikrowisp/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/connectors/smartolt/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/db/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/detection/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/eval/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/evidence/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/monitoring/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/security/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/shared/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/soc/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "apps/web/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "apps/web/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  }
}
