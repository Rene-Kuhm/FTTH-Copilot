# ============================================
# FTTH-Copilot — staging
#
# Plantilla del entorno de staging. Es un subconjunto de `.env.example` con
# los valores propios del staging; el resto se hereda de `.env.example`.
#
#   cp .env.staging.example .env.staging
#
# El compose de staging se levanta con:
#
#   docker compose --env-file .env.staging \
#     -f docker-compose.prod.yml -f docker-compose.staging.yml up -d
#
# La decisión de dónde montarlo y con qué Redis y Postgres está en
# `docs/how-to/desplegar-en-staging.md`.
# ============================================

# ── Secretos ────────────────────────────────────────────────────────────
# Los dos bloquean el arranque en producción: el proceso lanza si faltan.
#   openssl rand -hex 32   # uno para cada uno, distintos
JWT_SECRET=replace-with-a-random-32-byte-secret
KMS_MASTER_KEY=replace-with-a-different-random-32-byte-secret

# ── Base de datos ───────────────────────────────────────────────────────
# La web y el db-migrate llegan a Postgres por el nombre del servicio en la
# red de Compose; el worker, que corre en la red del host, llega por
# 127.0.0.1. Las tres URLs las arma el compose a partir de estas variables,
# así que no hay que escribirlas a mano (y no pueden quedar con una password
# distinta).
POSTGRES_USER=ftth
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ftth_copilot
# Puerto en el host, sólo loopback. Cambiarlo si el servidor ya tiene un
# Postgres escuchando.
#
# El staging y producción tienen que poder convivir en un mismo host, así que
# los puertos del staging son distintos de los que usa producción (5432) y de
# los que toma el worker en la red del host.
POSTGRES_PORT=5434

# ── Redis (cola del worker + rate limiter global) ──────────────────────
# Misma variable para las dos cosas: la cola del worker y el límite global
# de las rutas que mutan estado. La URL la arma el compose por servicio
# (`redis:6379` para la web, `127.0.0.1:6379` para el worker).
#   openssl rand -hex 32
REDIS_PASSWORD=replace-me
# Distinto del 6379 de producción, por el mismo motivo que Postgres.
REDIS_PORT=6380

# ── Worker ──────────────────────────────────────────────────────────────
# El worker corre en la red del host: su health y sus dos sockets UDP
# (syslog y SNMP) se bindean en el host, no en la red de Compose. Los puertos
# por defecto (8081, 5514 y 1162) son los de producción, así que el staging
# usa otros.
WORKER_PORT=8082
SYSLOG_UDP_PORT=5515
SNMP_UDP_PORT=1163

# ── Servidor ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# El staging sirve HTTP plano (Caddy en el 8080, sin dominio): sin esto la
# cookie de sesión lleva `Secure` y el navegador no la manda. Con HTTPS
# real, ponerlo en `true`.
SESSION_COOKIE_SECURE=false
# Puerto en el host donde queda Caddy.
STAGING_HTTP_PORT=8080

# ── Background worker ───────────────────────────────────────────────────
# El compose de staging lo fuerza a `worker`; se repite acá para que quede
# a la vista. El modo `embedded` ya no existe: la web no arranca los loops ni
# el receptor syslog, y el worker los corre una sola vez.
BACKEND_MODE=worker
WORKER_HOST=127.0.0.1

# ── Datos del staging ───────────────────────────────────────────────────
# Sin fixtures: los datos de staging son de un NMS real o del mock.
DEMO_MODE_ENABLED=false
SMARTOLT_USE_MOCK=false
SMARTOLT_API_BASE_URL=https://api.smartolt.com
SMARTOLT_API_KEY=
# Tenant al que se atribuyen los eventos del receptor syslog.
SYSLOG_TENANT_ID=
SYSLOG_RECEIVER_ENABLED=false
SNMP_RECEIVER_ENABLED=false
# Tenant de la evidencia cruda de los traps SNMP. Es un tenant propio, y
# tiene que existir: sin esta variable el worker guarda la evidencia bajo
# `default-tenant`, que el seed no crea, y cada trap pierde su evidencia.
SNMP_TENANT_ID=demo-tenant
METRICS_POLLER_ENABLED=true

# ── Mock NMS ────────────────────────────────────────────────────────────
# El staging necesita un NMS contra el que polear. El compose lo declara
# detrás del profile `mock-nms` (`docker compose --profile mock-nms up -d`)
# y sirve el mock que ya está en el repo, por HTTP, en el puerto del host.
# Un staging con un NMS real no lo levanta y deja estas variables vacías.
MOCK_NMS_PORT=18080
MOCK_NMS_HOST=127.0.0.1
# URL base de la conexión que crea el seed. Sin ella la conexión no la
# puede usar ningún loop: el conector no se construye sin una URL base.
DEMO_NMS_BASE_URL=http://127.0.0.1:18080

# ── Política SSRF ───────────────────────────────────────────────────────
# El mock NMS vive en el loopback del host, así que la política SSRF —que
# por defecto sólo admite HTTPS, sin localhost, sin redes privadas y en el
# puerto 443— tiene que exceptuarse para poder apuntar a él.
#
# NUNCA van a producción: con estas excepciones activadas, un NMS (o un
# atacante con un DNS) puede alcanzar la red interna. El arranque de
# producción las rechaza: con `NODE_ENV=production` y sin `DEPLOY_ENV=staging`
# el proceso no levanta.
NMS_ALLOW_HTTP=true
NMS_ALLOW_PRIVATE_NETWORKS=true
NMS_ALLOWED_HOSTS=127.0.0.1
NMS_ALLOWED_PORTS=18080

# ── Observabilidad ──────────────────────────────────────────────────────
# VictoriaMetrics queda en el loopback (el compose de staging lo publica
# sólo en 127.0.0.1). El worker expone su health en el loopback también:
# para que VictoriaMetrics lo scrapee hay que apuntar
# VICTORIAMETRICS_WORKER_SCRAPE_TARGET a una dirección alcanzable.
VICTORIAMETRICS_WORKER_SCRAPE_TARGET=
METRICS_BEARER_TOKEN=
DEPLOY_ENV=staging
