# ============================================
# FTTH-Copilot — environment variables template
# Copy this file to .env and fill in real values
# ============================================

# Anthropic API key (REQUIRED for the agent)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model selection (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server
PORT=3000
NODE_ENV=development

# SmartOLT connector
# Set to "true" to use fixtures/mock data (no real API calls)
SMARTOLT_USE_MOCK=true

# Real SmartOLT credentials (only used when SMARTOLT_USE_MOCK=false)
SMARTOLT_API_BASE_URL=https://api.smartolt.com
SMARTOLT_API_KEY=

# Logging
LOG_LEVEL=info
