# ============================================
# FTTH-Copilot — environment variables template
# Copy this file to .env and fill in real values
# ============================================

# LLM provider (MiniMax token plan, Anthropic-API-compatible)
# Get your key from https://platform.minimax.io
MINIMAX_API_KEY=sk-cp-your-key-here

# Optional overrides
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3

# PostgreSQL (required for auth, sessions, connectors and conversations)
DATABASE_URL=postgresql://ftth:change-me@localhost:5432/ftth_copilot

# Auth and encryption — generate independent random values of at least 32 bytes
JWT_SECRET=replace-with-a-random-32-byte-secret
KMS_MASTER_KEY=replace-with-a-different-random-32-byte-secret

# Server
PORT=3001
NODE_ENV=development

# Explicit demo mode. Keep false in production so fixtures can never replace a real NMS silently.
DEMO_MODE_ENABLED=true

# Chat cost controls (atomic PostgreSQL-backed limiter, shared by all instances)
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_QUOTA=200

# SmartOLT connector
# Set to "true" to use fixtures/mock data (no real API calls)
SMARTOLT_USE_MOCK=true

# Real SmartOLT credentials (only used when SMARTOLT_USE_MOCK=false)
SMARTOLT_API_BASE_URL=https://api.smartolt.com
SMARTOLT_API_KEY=

# Outbound NMS network policy
NMS_REQUEST_TIMEOUT_MS=10000
NMS_ALLOWED_PORTS=443
# Optional comma-separated exact hostname allowlist (recommended in production)
NMS_ALLOWED_HOSTS=
# Explicit self-hosted opt-ins; keep false unless the server must reach a trusted LAN NMS
NMS_ALLOW_HTTP=false
NMS_ALLOW_PRIVATE_NETWORKS=false

# Cloudflare tunnel (only required by ecosystem.config.cjs)
CLOUDFLARED_TOKEN=

# Proactive metrics poller (early-warning detection)
# Disabled by default so dev/preview/test instances never poll the NMS.
METRICS_POLLER_ENABLED=false
METRICS_POLL_INTERVAL_MS=900000
METRICS_RETENTION_DAYS=30
# Fan out to getOltDetail() per OLT for temperature/uptime (rate-limit aware).
METRICS_SAMPLE_OLT_DETAIL=false

# Proactive alert notifications
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=3600000

# Logging
LOG_LEVEL=info
