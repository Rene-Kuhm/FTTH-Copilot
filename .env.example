# ============================================
# FTTH-Copilot — environment variables template
# Copy this file to .env and fill in real values
# ============================================

# LLM provider (MiniMax token plan, Anthropic-API-compatible)
# Get your key from https://platform.minimax.io
MINIMAX_API_KEY=sk-cp-your-key-here

# Optional overrides
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3

# PostgreSQL (required for auth, sessions, connectors and conversations)
DATABASE_URL=postgresql://ftth:change-me@localhost:5432/ftth_copilot

# Auth and encryption — generate independent random values of at least 32 bytes
JWT_SECRET=replace-with-a-random-32-byte-secret
KMS_MASTER_KEY=replace-with-a-different-random-32-byte-secret

# Server
PORT=3001
NODE_ENV=development

# Explicit demo mode. Keep false in production so fixtures can never replace a real NMS silently.
DEMO_MODE_ENABLED=true

# Chat cost controls (atomic PostgreSQL-backed limiter, shared by all instances)
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_QUOTA=200

# Auth rate limiting (brute-force protection for login/signup)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# SmartOLT connector
# Set to "true" to use fixtures/mock data (no real API calls)
SMARTOLT_USE_MOCK=true

# Real SmartOLT credentials (only used when SMARTOLT_USE_MOCK=false)
SMARTOLT_API_BASE_URL=https://api.smartolt.com
SMARTOLT_API_KEY=

# Outbound NMS network policy
NMS_REQUEST_TIMEOUT_MS=10000
NMS_ALLOWED_PORTS=443
# Optional comma-separated exact hostname allowlist (recommended in production)
NMS_ALLOWED_HOSTS=
# Explicit self-hosted opt-ins; keep false unless the server must reach a trusted LAN NMS
NMS_ALLOW_HTTP=false
NMS_ALLOW_PRIVATE_NETWORKS=false

# Cloudflare tunnel (only required by ecosystem.config.cjs)
CLOUDFLARED_TOKEN=

# Proactive metrics poller (early-warning detection)
# Disabled by default so dev/preview/test instances never poll the NMS.
METRICS_POLLER_ENABLED=false
METRICS_POLL_INTERVAL_MS=900000
METRICS_RETENTION_DAYS=30
# Fan out to getOltDetail() per OLT for temperature/uptime (rate-limit aware).
METRICS_SAMPLE_OLT_DETAIL=false

# Proactive alert notifications
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=3600000
# An open alert with no matching finding for this long is auto-resolved.
ALERT_RESOLVE_AFTER_MS=86400000
# An unacknowledged warning alert older than this is escalated to critical.
ALERT_ESCALATE_AFTER_MS=14400000
# Telegram push notifications (both must be set; empty = disabled).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firmware audit (SOC). Disabled by default; runs on a slower cadence than
# the metrics poller because firmware changes infrequently. When enabled,
# reads live firmware versions via the connector (fan-out to getOnuDetail)
# and flags any device whose firmware matches the allowlist below.
FIRMWARE_AUDIT_ENABLED=false
FIRMWARE_AUDIT_INTERVAL_MS=86400000
# Comma-separated list of known-vulnerable firmware versions. Empty = use
# the package default (a small, audited baseline).
FIRMWARE_AUDIT_VULNERABLE_LIST=

# SOC syslog receiver (security events)
# Disabled by default; requires SYSLOG_TENANT_ID to attribute events to a tenant.
SYSLOG_RECEIVER_ENABLED=false
SYSLOG_UDP_PORT=5514
SYSLOG_TENANT_ID=
SYSLOG_DETECTION_INTERVAL_MS=60000
# DoS bounds on ingestion: max stored message length and max events per minute
# (excess datagrams are dropped).
SYSLOG_MAX_MESSAGE_LENGTH=2000
SYSLOG_MAX_EVENTS_PER_MINUTE=1000

# Logging
LOG_LEVEL=info

# LLM providers (used by the chat agent in agent-core).
# LLM_PROVIDER selects a single provider. LLM_FALLBACK is a comma-separated
# ordered list that wraps the providers in a fallback chain (transient errors
# only: timeouts, 429, 5xx). Leave both unset to disable the chat agent.
#
# Supported providers:
#   minimax  — Anthropic-compatible (https://api.minimax.io/anthropic)
#   deepseek — OpenAI-compatible (https://api.deepseek.com/v1)
#   qwen     — OpenAI-compatible (https://dashscope.aliyuncs.com/compatible-mode/v1)
#
# Examples:
#   LLM_PROVIDER=minimax
#   LLM_FALLBACK=minimax,deepseek,qwen
LLM_PROVIDER=
LLM_FALLBACK=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
