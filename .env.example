# ============================================
# FTTH-Copilot — environment variables template
# Copy this file to .env and fill in real values
# ============================================

# PostgreSQL (required for auth, sessions, connectors and conversations)
DATABASE_URL=postgresql://ftth:change-me@localhost:5432/ftth_copilot

# Auth and encryption — generate independent random values of at least 32 bytes
JWT_SECRET=replace-with-a-random-32-byte-secret
KMS_MASTER_KEY=replace-with-a-different-random-32-byte-secret
# Optional seed password override for development (defaults to random one-time password)
SEED_ADMIN_PASSWORD=

# Server
PORT=3001
NODE_ENV=development
# Set false only for the local desktop HTTP runtime; keep true for HTTPS production.
SESSION_COOKIE_SECURE=false

# Explicit demo mode. Keep false in production so fixtures can never replace a real NMS silently.
DEMO_MODE_ENABLED=true

# Chat cost controls (atomic PostgreSQL-backed limiter, shared by all instances)
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_QUOTA=200

# Cognitive investigation cost controls & quotas
INVESTIGATION_RATE_LIMIT_PER_MINUTE=10
INVESTIGATION_DAILY_QUOTA=100

# Auth rate limiting (brute-force protection for login/signup)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# SmartOLT connector
# Set to "true" to use fixtures/mock data (no real API calls)
SMARTOLT_USE_MOCK=true

# Real SmartOLT credentials (only used when SMARTOLT_USE_MOCK=false)
SMARTOLT_API_BASE_URL=https://api.smartolt.com
SMARTOLT_API_KEY=

# Mikrowisp connector (alternative NMS provider)
MIKROWISP_API_BASE_URL=https://demo.mikrowisp.com/api/v1
MIKROWISP_TOKEN=

# Outbound NMS network policy
NMS_REQUEST_TIMEOUT_MS=10000
NMS_ALLOWED_PORTS=443
# Optional comma-separated exact hostname allowlist (recommended in production)
NMS_ALLOWED_HOSTS=
# Explicit self-hosted opt-ins; keep false unless the server must reach a trusted LAN NMS
NMS_ALLOW_HTTP=false
NMS_ALLOW_PRIVATE_NETWORKS=false

# Cloudflare tunnel (only required by ecosystem.config.cjs)
CLOUDFLARED_TOKEN=

# Proactive metrics poller (early-warning detection)
# Disabled by default so dev/preview/test instances never poll the NMS.
METRICS_POLLER_ENABLED=false
METRICS_POLL_INTERVAL_MS=900000
METRICS_RETENTION_DAYS=30
# Fan out to getOltDetail() per OLT for temperature/uptime (rate-limit aware).
METRICS_SAMPLE_OLT_DETAIL=false
# Prometheus metrics exporter (/api/metrics). If set, enforces Bearer token authentication.
METRICS_BEARER_TOKEN=

# Proactive alert notifications
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=3600000
# An open alert with no matching finding for this long is auto-resolved.
ALERT_RESOLVE_AFTER_MS=86400000
# An unacknowledged warning alert older than this is escalated to critical.
ALERT_ESCALATE_AFTER_MS=14400000
# Telegram push notifications (both must be set; empty = disabled).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firmware audit (SOC). Disabled by default; runs on a slower cadence than
# the metrics poller because firmware changes infrequently. When enabled,
# reads live firmware versions via the connector (fan-out to getOnuDetail)
# and flags any device whose firmware matches the allowlist below.
FIRMWARE_AUDIT_ENABLED=false
FIRMWARE_AUDIT_INTERVAL_MS=86400000
# Comma-separated list of known-vulnerable firmware versions. Empty = use
# the package default (a small, audited baseline).
FIRMWARE_AUDIT_VULNERABLE_LIST=

# Optical FEC collection (scheduler)
FEC_COLLECTION_ENABLED=false
FEC_COLLECTION_INTERVAL_MS=3600000
FEC_FAN_OUT_PER_CYCLE=8
FEC_RATE_LIMIT_PER_HOUR=15

# SNMP trap receiver (telemetry & events)
SNMP_RECEIVER_ENABLED=false
SNMP_UDP_PORT=1162
SNMP_MAX_PAYLOAD_BYTES=2048
SNMP_MAX_EVENTS_PER_MINUTE=1000
SNMP_DEDUP_WINDOW_MS=5000
SNMP_DISABLE_AUTH=false
SNMP_SENDER_REGISTRY_JSON=

# Maintenance windows re-evaluation
MAINTENANCE_REEVAL_ENABLED=false

# Agent TruthGate mode ('strict' | 'observe')
TRUTH_GATE_MODE=strict

# Simulator flags (development/testing only; forbidden in production)
FTTH_SIMULATOR_ALLOW_PROVISIONAL=false

# SOC syslog receiver (security events)
# Disabled by default; requires SYSLOG_TENANT_ID to attribute events to a tenant.
SYSLOG_RECEIVER_ENABLED=false
SYSLOG_UDP_PORT=5514
SYSLOG_TENANT_ID=
SYSLOG_DETECTION_INTERVAL_MS=60000
# DoS bounds on ingestion: max stored message length and max events per minute
# (excess datagrams are dropped).
SYSLOG_MAX_MESSAGE_LENGTH=2000
SYSLOG_MAX_EVENTS_PER_MINUTE=1000

# Logging
LOG_LEVEL=info

# LLM providers (used by the chat agent in agent-core).
# LLM_PROVIDER selects a single provider (minimax, deepseek, or qwen).
# LLM_FALLBACK is a comma-separated ordered list (e.g. minimax,deepseek,qwen)
# that wraps providers in a fallback chain (transient errors only: 429, 5xx).
# Leave LLM_PROVIDER empty to disable the chat agent until an API key is configured.
LLM_PROVIDER=
LLM_FALLBACK=

# MiniMax (token plan, Anthropic-API-compatible)
# Get your key from https://platform.minimax.io
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3

# DeepSeek (OpenAI-API-compatible)
# Get your key from https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Qwen (DashScope OpenAI-compatible)
# Get your key from https://dashscope.console.aliyun.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Arize Phoenix LLM Tracing (OpenInference / OpenTelemetry)
# Set endpoint to enable trace export to Arize Phoenix (e.g. http://localhost:6006/v1/traces).
# Spans are strictly redacted of credentials and secrets before transmission.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=ftth-copilot

# ============================================
# Laya Decision Layer — Fast Decision System (ADR-042)
# Expert System (94.4% accuracy) — no GPU required
# ============================================

# Enable Laya decision layer
LAYA_ENABLED=false

# Operating mode: shadow (default) | assisted | automatic | disabled
# shadow  = Laya decides but results only logged, no routing impact
# assisted = Laya suggests route, router can follow
# automatic = Laya directly influences routing
# disabled = Laya bypassed entirely
LAYA_MODE=shadow

# When Laya is unavailable, fail-open (continue pipeline) vs fail-closed (stop)
LAYA_FAIL_OPEN=true

# Minimum confidence threshold for Laya to influence routing (0.0-1.0)
LAYA_MIN_CONFIDENCE=0.75

# Suggest route based on Laya decision (adds eventClass/eventConfidence to routing)
LAYA_SUGGEST_ROUTE=false

# Allow Laya to take direct route in automatic mode (bypasses router)
LAYA_ALLOW_DIRECT_ROUTING=false

# Optional: URL for Laya microservice (not needed for module import mode)
# LAYA_URL=http://localhost:8000

# Optional: Timeout for Laya HTTP calls (milliseconds)
# LAYA_TIMEOUT_MS=250

# Optional: High/low confidence thresholds for Laya route following
# LAYA_CONFIDENCE_THRESHOLD_HIGH=0.95
# LAYA_CONFIDENCE_THRESHOLD_LOW=0.75

# Optional: Laya model identifier
# LAYA_MODEL=laya-multilingual
# LAYA_MODEL_VERSION=1.0.0

# Logging level for Laya decisions (development only)
# LAYA_LOG_LEVEL=debug

# ============================================
# Laya Decision Layer — Fast Decision System (ADR-042)
# Expert System (94.4% accuracy) — no GPU required
# ============================================

# Enable Laya decision layer
LAYA_ENABLED=false

# Operating mode: shadow (default) | assisted | automatic | disabled
# shadow    = Laya decides but results only logged, no routing impact
# assisted  = Laya suggests route, router can follow
# automatic = Laya directly influences routing
# disabled  = Laya bypassed entirely
LAYA_MODE=shadow

# When Laya is unavailable, fail-open (continue) vs fail-closed (stop)
LAYA_FAIL_OPEN=true

# Minimum confidence threshold (0.0-1.0)
LAYA_MIN_CONFIDENCE=0.75

# Suggest route based on Laya decision
LAYA_SUGGEST_ROUTE=false

# Allow Laya direct routing in automatic mode
LAYA_ALLOW_DIRECT_ROUTING=false

# Optional: Laya microservice URL (module import does not need this)
# LAYA_URL=http://localhost:8000

# Optional: HTTP timeout in milliseconds
# LAYA_TIMEOUT_MS=250

# Optional: Confidence thresholds for assisted mode
# LAYA_CONFIDENCE_THRESHOLD_HIGH=0.95
# LAYA_CONFIDENCE_THRESHOLD_LOW=0.75

# Optional: Laya model identifier
# LAYA_MODEL=laya-multilingual
# LAYA_MODEL_VERSION=1.0.0

# Logging level (development only)
# LAYA_LOG_LEVEL=debug

# ── VictoriaMetrics — Time-series database (replaces Prometheus) ─────────────
# Installed automatically via docker-compose.demo.yml or docker-compose.prod.yml.
# Access VM UI: http://localhost:${VICTORIAMETRICS_PORT:-8428}
# Docs: https://docs.victoriametrics.com/
#
# VICTORIAMETRICS_PORT=8428         # Port for VM UI and API (change if 8428 is busy)
# VICTORIAMETRICS_RETENTION=12      # Retention in months (12 = 1 year, 60 = 5 years)
#   Development: 1  (1 month, low disk usage)
#   Production:  12 (1 year, recommended minimum)
#   Long-term:   60 (5 years, requires adequate storage)
#
# Note: METRICS_BEARER_TOKEN is shared between the app and VM.
# If set, VM includes it in the scrape request to /api/metrics.
