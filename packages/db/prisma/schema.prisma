// FTTH-Copilot — Prisma schema
// Multi-tenant from day 1 (per project guide §3.1).
// All sensitive data encrypted at rest (API keys in NmsConnection).

generator client {
  provider = "prisma-client-js"
  // Output to the package's src/generated directory so other packages
  // can import the typed client.
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
  MEMBER // legacy — treated as OPERATOR in permissions
}

enum NmsProvider {
  SMARTOLT
  MIKROWISP
  NETSENSE
  MIKROTIK
}

enum NmsConnectionStatus {
  connected
  error
  pending
}

enum MessageRole {
  user
  assistant
  tool
}

// Time-series metrics ingested from NMS connectors, used for proactive
// (early-warning) detection. One row per (device, metric, sample time).
enum DeviceKind {
  OLT
  ONU
}

enum MetricKind {
  RX_POWER_DBM
  TX_POWER_DBM
  TEMPERATURE_CELSIUS
  UPTIME_SECONDS
  STATUS
  FEC_CORRECTED
  FEC_UNCORRECTED
  BIAS_CURRENT_MA
  ONT_TEMPERATURE_CELSIUS
  LOS_SECONDS_TOTAL
  TRAFFIC_THROUGHPUT_MBPS
}

// Persistent, deduplicated proactive alerts produced by the detection engine.
enum AlertKind {
  predicted_low_signal
  predicted_high_temperature
  intermittent_connection
  frequent_reboots
  metric_anomaly
  fec_degradation
  optical_degradation
  traffic_anomaly
}

enum AlertSeverity {
  warning
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

// Coarse security category of an ingested device (syslog) event.
enum DeviceEventCategory {
  auth_failure
  access
  config_change
  other
}

// Source of truth for how a ConfirmedIncident row was confirmed.
// `operator` = manual confirmation via the operator UI/POST confirm route.
// `agent`    = auto-promoted from a PendingIncidentCandidate by the admin
//              promotion route after the Incident has been resolved ≥24h.
// `system`   = reserved for backfill or future system-initiated paths.
enum ConfirmedBy {
  operator
  agent
  system
}

// Fase E — per-tenant override of Fase C/D module constants. One row per
// Tenant (1:1). Absent → byte-identical to Fase C/D; per-tenant wins over
// env over module default. See `openspec/changes/fase-e-tenant-topology/`.
enum TruthGateMode {
  observe
  strict
}

// Lifecycle of a PendingIncidentCandidate before promotion to ConfirmedIncident.
enum PendingIncidentStatus {
  pending
  promoted
  rejected
}

// Fase E — temporal topology node kinds. The hierarchy is fixed
// (OLT → PON_PORT → SPLITTER → CTO → ONU) and the BFS helpers in
// `@ftth-copilot/evidence` operate against edges only; this enum exists so
// the parent/child sides of every edge are strongly typed in Postgres.
enum TopologyNodeKind {
  OLT
  PON_PORT
  SPLITTER
  CTO
  ONU
}

// Fase F — VerdictCode enumeration. Mirrors the TypeScript `VerdictCode`
// union in `@ftth-copilot/evidence` (Fase B TruthGate). Used by the
// `verdict_log` table to classify each persisted verdict at write time so
// the v1 persistence layer is filterable by code without a JSON cast.
enum VerdictCode {
  ok
  low_confidence
  stale
  incomplete
}

// Fase F — VerdictSeverity enumeration. Mirrors the TypeScript
// `VerdictSeverity` union in `@ftth-copilot/evidence`. Severity is the
// "how loud should we be" dimension that complements `code` (the "what
// happened" dimension) — Fase F persistence keeps both so nightly
// coverage / abstention / gate-FP metrics can slice on either.
enum VerdictSeverity {
  ok
  info
  warning
  critical
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // for subdomains/URLs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  connections    NmsConnection[]
  conversations  Conversation[]
  actionLog      AgentActionLog[]
  metricSamples  MetricSample[]
  detectedAlerts DetectedAlert[]
  incidents      Incident[]
  deviceEvents   DeviceEvent[]

  confirmedIncidents        ConfirmedIncident[]
  pendingIncidentCandidates PendingIncidentCandidate[]
  policy                    TenantPolicy?
  topologyEdges             TopologyEdge[]
  verdictLog                VerdictLog[]
  InvestigationRun          InvestigationRun[]
  InvestigationVersion      InvestigationVersion[]
  InvestigationFeedback     InvestigationFeedback[]
  maintenanceWindows        MaintenanceWindow[]
  fiberPlans                FiberPlan[]
  planZones                 PlanZone[]
  planMarkers               PlanMarker[]

  // Laya Decision Layer (ADR-042)
  decisionEvaluations DecisionEvaluation[]
  snmpEvidence SnmpEvidence[]

  // NOC/SOC AIOps
  geoZones               GeoZone[]
  runbooks               Runbook[]
  changeEvents           ChangeEvent[]
  correlationWeight      CorrelationWeight?
  correlationOutcomes    CorrelationOutcome[]
  notificationChannels   NotificationChannel[]
  notificationDeliveries NotificationDelivery[]
  auditLogs             AuditLog[]

  // Enterprise: On-Call Scheduling
  onCallSchedules       OnCallSchedule[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String // bcrypt; never logged
  role         Role     @default(MEMBER)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // MFA (TOTP) fields
  totpSecret  String?  @map("totp_secret") // Base32-encoded TOTP secret, encrypted at rest
  mfaEnabled  Boolean  @default(false) @map("mfa_enabled")

  sessions               Session[]
  conversations          Conversation[]
  rateLimitBuckets       RateLimitBucket[]
  confirmedIncidents     ConfirmedIncident[]
  investigationRuns      InvestigationRun[]      @relation("InvestigationRunRequestedBy")
  investigationFeedbacks InvestigationFeedback[] @relation("InvestigationFeedbackAuthor")

  // Enterprise: On-Call Scheduling (one-way reference only)
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // SHA-256 of the JWT (we send the JWT, store its hash)
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model NmsConnection {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider      NmsProvider
  label         String // human-readable: "SmartOLT prod"
  encryptedKey  String // AES-256-GCM ciphertext of the NMS API key
  baseUrl       String? // SmartOLT default, Mikrowisp per-subdomain
  status        NmsConnectionStatus @default(pending)
  lastCheckedAt DateTime?
  lastError     String? // truncated last error for UI
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  conversations      Conversation[]
  metricSamples      MetricSample[]
  detectedAlerts     DetectedAlert[]
  incidents          Incident[]
  deviceEvents       DeviceEvent[]
  confirmedIncidents ConfirmedIncident[]
  fiberPlans         FiberPlan[]
  InvestigationRun   InvestigationRun[]

  @@unique([tenantId, provider, label])
  @@index([tenantId])
  @@map("nms_connections")
}

model Conversation {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String? // auto-generated from first message, can be null
  connectionId String?
  // Optional: tie conversation to a specific NMS connection (so multi-tenant users
  // can have different conversations per connector)
  connection   NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages Message[]

  @@index([tenantId, userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  toolCalls      Json? // schema: [{name, args, result}]
  toolName       String? // for role = 'tool', which tool produced this
  toolResultJson Json? // raw tool result for tool messages
  createdAt      DateTime     @default(now())
  verdictLog     VerdictLog[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AgentActionLog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  connectionId   String?
  conversationId String?
  toolName       String
  parameters     Json
  result         Json?
  durationMs     Int
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("agent_action_log")
}

model MetricSample {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  deviceKind   DeviceKind
  deviceId     String
  kind         MetricKind
  value        Float? // numeric metrics (rx/tx power, temperature, uptime)
  valueText    String? // categorical metrics (STATUS: online/offline/degraded)
  sampledAt    DateTime       @default(now())
  createdAt    DateTime       @default(now())

  @@index([tenantId, connectionId, deviceKind, deviceId, kind, sampledAt])
  @@index([tenantId, sampledAt])
  @@index([sampledAt])
  @@map("metric_samples")
}

model DetectedAlert {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  kind           AlertKind
  severity       AlertSeverity
  deviceKind     DeviceKind
  deviceId       String
  title          String
  description    String
  etaMs          Int?
  confidence     Float?
  status         AlertStatus    @default(open)
  firstSeenAt    DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  lastNotifiedAt DateTime?
  resolvedAt     DateTime?
  incidentId     String?
  incident       Incident?      @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([tenantId, connectionId, kind, deviceKind, deviceId])
  @@index([tenantId, status, lastSeenAt])
  @@index([incidentId])
  @@map("detected_alerts")
}

// A correlated incident: groups multiple active alerts on the same device
// (e.g. one ONU with several concurrent problems) so the NOC sees one unit
// of work instead of an alert storm.
model Incident {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  deviceKind   DeviceKind
  deviceId     String
  title        String
  description  String
  severity     AlertSeverity
  status       AlertStatus    @default(open)
  firstSeenAt  DateTime       @default(now())
  lastSeenAt   DateTime       @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  alerts DetectedAlert[]

  @@unique([tenantId, connectionId, deviceKind, deviceId])
  @@index([tenantId, status, lastSeenAt])
  @@map("incidents")
}

// A raw device (syslog) event ingested for SOC analysis. deviceId is resolved
// by the receiver from the event's source; null until that mapping exists.
model DeviceEvent {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   NmsConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  sourceIp     String?
  facility     Int?
  severity     Int?
  category     DeviceEventCategory @default(other)
  message      String              @db.Text
  occurredAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())

  // Stable id assigned by the ingest spool when the event is received, so a
  // retry after a crash is deduplicated instead of creating a second row.
  // Null on rows written before durable ingest; Postgres treats NULLs as
  // distinct, so the unique index allows any number of them.
  ingestId String? @unique

  // Device context (resolved from SNMP trap OID / syslog parser)
  deviceKind String?
  deviceId   String?

  @@index([tenantId, category, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("device_events")
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(0)

  @@unique([userId, scope, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// Generic key-based rate-limit counters for unauthenticated operations
// (login/signup brute-force protection). Keyed by an arbitrary string
// (e.g. "login:email:x@y.z" or "login:ip:1.2.3.4") with no user FK, since the
// attacker is not authenticated yet.
model AuthRateLimit {
  id          String   @id @default(cuid())
  key         String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

// Confirmed incident memory (Fase D — sparse-first hybrid RAG).
//
// Two confirmation paths feed this table:
//   - operator: POST /api/incidents/:id/confirm with view_network permission
//   - agent:    promotePendingIncidents() after Incident resolved ≥24h with no
//               incomplete verdict in the originating run
//
// searchTokens is the pre-computed, lowercased, stop-word-trimmed token string
// that the BM25 scorer in @ftth-copilot/evidence compares against the query.
// The Phase 2 pgvector `embedding` column is reserved nullable; no dense path
// is implemented yet (deferred per the Fase D proposal).
model ConfirmedIncident {
  id                      String         @id @default(cuid())
  tenantId                String
  tenant                  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId            String?
  connection              NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  deviceKind              DeviceKind
  deviceId                String
  sourceIncidentId        String? // soft reference to Incident.id; no FK (incidents stay deletable)
  // Cognitive-investigation (Fase 1, soft reference). The technician's
  // feedback that motivated this promotion. NO FK: a feedback is
  // optional and its deletion MUST NOT cascade into ConfirmedIncident
  // (which is the immutable knowledge base). Application layer validates
  // (tenantId, feedbackId) on insert.
  investigationFeedbackId String?
  sourceTool              String
  summary                 String         @db.Text
  symptoms                Json
  rootCause               String         @db.Text
  fix                     String         @db.Text
  observedAt              DateTime
  resolvedAt              DateTime
  severity                AlertSeverity
  confirmedBy             ConfirmedBy
  confirmedByUserId       String?
  confirmedByUser         User?          @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  searchTokens            String         @db.Text // precomputed BM25 tokens, lowercased
  embedding               Bytes? // nullable; Phase 2 pgvector deferred
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([tenantId, deviceKind, deviceId])
  @@index([tenantId, resolvedAt])
  @@index([tenantId, connectionId])
  @@index([tenantId, investigationFeedbackId])
  // Enforces the one-per-source-incident rule the code already assumes.
  // Without it, the confirm route and the promote loop can both race past
  // their existence check and store the same incident twice. Nullable, so
  // rows without a source incident are unaffected (Postgres treats NULLs as
  // distinct).
  @@unique([tenantId, sourceIncidentId])
  @@map("confirmed_incidents")
}

// Candidate row written by the chat route after a clean (non-abstained, no
// incomplete verdict) run in live mode. Promoted to ConfirmedIncident by the
// admin route after the linked Incident has been resolved ≥24h.
model PendingIncidentCandidate {
  id                  String                @id @default(cuid())
  tenantId            String
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceIncidentId    String? // soft reference; no FK
  summary             String                @db.Text
  toolCallsJson       Json
  runSessionId        String?
  proposedConfirmedAt DateTime
  status              PendingIncidentStatus @default(pending)
  createdAt           DateTime              @default(now())

  @@index([tenantId, status])
  @@map("pending_incident_candidates")
}

// Laya Decision Layer (ADR-042) — Shadow mode evaluation record.
//
// Stores Laya decisions for:
// - Shadow mode: compare Laya decisions vs actual routing
// - Benchmark: measure accuracy, precision, recall per class
// - Fine-tuning: build training dataset from operator-confirmed outcomes
// - Calibration: track confidence vs actual outcome
//
// NOT used for real-time routing until assisted/automatic modes are validated.
model DecisionEvaluation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Event reference
  eventId         String  @db.Text
  eventSource     String? // 'smartolt', 'snmp', 'syslog', etc.
  eventRawSummary String? @db.Text // sanitized, no credentials

  // Laya model info
  engine       String  @default("laya")
  model        String // e.g., 'laya-multilingual'
  modelVersion String?

  // Laya decision (what Laya decided)
  eventClass            String? // LayaEventClass enum value
  severity              String? // LayaSeverity enum value
  probableScope         String? // LayaProbableScope enum value
  suggestedRoute        String? // LayaSuggestedRoute enum value
  requiresInvestigation Boolean?

  // Confidence scores as JSON
  confidence Json?

  // Latency
  latencyMs Int?

  // Actual routing (for shadow mode comparison)
  actualRoute     String? // What FTTH-Copilot actually did
  actualDiagnosis String? @db.Text
  operatorOutcome String? // Confirmed by operator later

  // Shadow mode flag
  shadow Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, eventClass])
  @@index([tenantId, shadow])
  @@index([model, eventClass])
  @@map("decision_evaluations")
}

// Fase E — per-tenant override envelope (1:1 with Tenant). Five nullable
// knobs, all independently optional; absent → Fase C/D module default.
// `schemaVersion` is a forward-compat migration lever; the matching zod
// contract is `tenantPolicySchema` (`ftth.tenant-policy.v1`) in
// `@ftth-copilot/shared`. `lastEvaluatedAt` is the timestamp the runtime
// last consulted the row (cheap observability hook for Fase E precedence
// logging). `abstainOnCodes` is JSON-stringified so we can ship without a
// Postgres-array dep — the chat route / promotion loader both decode it.
model TenantPolicy {
  tenantId           String         @id
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schemaVersion      Int            @default(1)
  retrievalLimit     Int?
  retrievalSinceDays Int?
  truthGateMode      TruthGateMode?
  abstainOnCodes     Json?
  promotionMinAgeMs  Int?
  lastEvaluatedAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("tenant_policies")
}

// Fase E — temporal topology (single-edge model). One row per directed
// parent → child edge in the FTTH hierarchy (OLT → PON_PORT → SPLITTER →
// CTO → ONU). Soft-expiry via nullable `validTo`; BFS helpers + Prisma
// reads filter `validTo: null`. The matching zod contract is
// `topologyEdgeSchema` (`ftth.topology-edge.v1`) in `@ftth-copilot/shared`.
// `source` is a non-empty free-form string for now (operator-entered,
// future ingestion layer).
model TopologyEdge {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentKind TopologyNodeKind
  parentId   String
  childKind  TopologyNodeKind
  childId    String
  validFrom  DateTime         @default(now())
  validTo    DateTime?
  source     String
  createdAt  DateTime         @default(now())

  @@index([tenantId, parentKind, parentId, validTo])
  @@index([tenantId, childKind, childId, validTo])
  @@map("topology_edges")
}

// Fase F — verdict log (v1 persistence surface for `AgentResult.verdicts`).
//
// One row per (message, tool-call verdict) emitted by the chat route after a
// `runAgent` returns with a non-empty `verdicts` array. `injectionSuspicion`
// is the fast-filter bit used to derive the nightly
// `injection_suspicion_total` metric from rows with code ∈
// {`stale`, `low_confidence`} — see `openspec/changes/fase-f-eval-injection/`
// §Risks. Conversation/message references are FK + CASCADE so deleting a
// tenant or a message removes its verdict log atomically.
//
// The matching zod contract is `verdictLogEntrySchema`
// (`ftth.verdict-log.v1`) in `@ftth-copilot/shared`. Fase 2 MAY consolidate
// this into `Message.verdicts Json?`; v1 keeps the table separate so the
// `Message` envelope stays byte-identical and every read path keeps its
// current shape (per design.md §Architecture Decisions #6).
model VerdictLog {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageId          String
  message            Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId     String? // soft ref; Message cascade covers cleanup
  toolName           String
  code               VerdictCode
  severity           VerdictSeverity
  observedAt         DateTime        @default(now())
  injectionSuspicion Boolean         @default(false)

  @@index([tenantId, observedAt])
  @@index([tenantId, code, observedAt])
  @@index([messageId])
  @@map("verdict_log")
}

model InvestigationRun {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId      String?
  connection        NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  // Soft reference to Incident.id (no FK) so deleting an Incident does
  // not cascade-delete the investigation history.
  incidentId        String?
  requestedByUserId String
  requestedByUser   User           @relation("InvestigationRunRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  // Opaque, application-controlled identifier exported via
  // packages/shared as `investigationRunIdSchema`. Never derived
  // from the Prisma id.
  runId             String
  // 'pending' | 'ready' | 'failed' | 'expired'. Phase 1 keeps this
  // constant 'pending' until Phase 3 starts producing versions.
  status            String         @default("pending")
  requestedAt       DateTime       @default(now())
  windowStart       DateTime?
  windowEnd         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // One-to-many to versions (real FK relation).
  // versions is fetched via the soft runId column on
  // InvestigationVersion — no Prisma relation needed.
  // Feedbacks use soft refs (runId, versionId); no Prisma relation
  // to keep the FK graph narrow and the cascade semantics explicit.

  @@unique([tenantId, runId])
  @@index([tenantId, requestedAt])
  @@index([tenantId, incidentId])
  @@map("investigation_runs")
}

model InvestigationVersion {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Soft FK. Run deletion does not cascade-delete versions.
  runRefId       String?
  // runRefId is denormalized; no Prisma relation — Run↔Version
  // relations are declared on Run.versions ("RunToVersions") only.
  runId          String
  versionId      String
  versionIndex   Int
  rulesetVersion String
  promptVersion  String
  modelVersion   String
  // No Prisma back-relations on Version: Run↔Version and
  // Version↔Feedback use soft IDs (runId, versionId) and SetNull FKs.
  // Application layer enforces the consistency.
  // Snapshot bounds. Empty JSON until fase 3 produces real evidence.
  snapshotJson   Json     @default("{}")
  snapshotAt     DateTime @default(now())

  @@unique([tenantId, runId, versionIndex])
  @@unique([tenantId, versionId])
  @@index([tenantId, runId])
  @@map("investigation_versions")
}

model InvestigationFeedback {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Soft references. Version is the unit being adjudicated; run is
  // duplicated here for O(1) (runId, versionId) lookup.
  // Soft reference: deleting an InvestigationRun orphans its
  // feedbacks (no FK cascade). Application layer keeps runId in sync.
  runRefId           String?
  // Real FK to InvestigationVersion: deleting a version nulls this
  // reference. The adjudication row persists for audit.
  versionRefId       String?
  // versionRefId is denormalized; the @unique on (runId, versionId, author, label)
  // enforces idempotency. No Prisma relation to InvestigationVersion
  // — application layer handles orphaning.
  runId              String
  versionId          String
  feedbackId         String
  // 'confirmed' | 'incorrect' | 'insufficient_data'. Phase 1 closes
  // this enum here; phase 5 may extend with 'maintenance' but that
  // requires a separate spec change.
  label              String
  // Optional free-text justification from the technician.
  observations       String?  @db.Text
  // Optional structured real cause when label = 'confirmed'.
  realCause          String?  @db.Text
  // Optional structured resolution evidence.
  resolutionEvidence String?  @db.Text
  authorUserId       String
  authorUser         User     @relation("InvestigationFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  submittedAt        DateTime @default(now())

  // Idempotency fingerprint. Same technician submitting the same
  // (runId, versionId, label) twice collapses to the same row (the
  // API returns the existing row). History is preserved (no
  // updates; new label ⇒ new row).
  @@unique([tenantId, runId, versionId, authorUserId, label])
  @@unique([tenantId, feedbackId])
  @@index([tenantId, versionId])
  @@index([tenantId, authorUserId, submittedAt])
  @@map("investigation_feedback")
}

// Fase 5 — Maintenance windows (roadmap 5.1 + 5.2).
//
// First version: no recurrences. Each window is a single time range
// with an explicit scope (devices / connection / tenant-wide).
// Solapamiento determinista: a new window that overlaps an existing
// one of the same tenant is REJECTED (no silent merge — evidence
// stays intact).
//
// Aditivo: this model does not change any existing table. The
// `manage_maintenance` flag (apps/web/lib/auth/permissions.ts) is
// off by default at the API layer: routes check the permission
// before any write.
model MaintenanceWindow {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  description        String?   @db.Text
  /// JSON scope descriptor: { kind: 'tenant' | 'connection' | 'device', ... }
  scopeJson          String    @db.Text
  startUtc           DateTime
  endUtc             DateTime
  /// IANA timezone string for display only (the start/end above are UTC).
  timezone           String
  /// 'scheduled' | 'cancelled' | 'completed'
  status             String    @default("scheduled")
  createdByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?   @db.Text

  @@index([tenantId, status, startUtc, endUtc])
  @@index([tenantId, startUtc, endUtc])
  @@map("maintenance_windows")
}

// Fiber Plan Viewer — visual fiber optic plan integration.
//
// Strategy: logical zones defined by the operator (no GPS/GIS required).
// A marker links a plan position to a topology node (deviceKind + deviceId),
// enabling alert→plan correlation without coordinate geometry.
//
// Model hierarchy:
//   Tenant  ──1:N──> FiberPlan ──1:N──> PlanZone ──1:N──> PlanMarker
//                                                   └──────────────> (optional FK)
//   PlanMarker also has a soft link to PlanZone via zoneId.

model FiberPlan {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId  String?
  connection    NmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  fileUrl       String         @map("file_url")
  mimeType      String         @map("mime_type")
  widthPx       Int?           @map("width_px")
  heightPx      Int?           @map("height_px")
  fileSizeBytes BigInt?        @map("file_size_bytes")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  zones PlanZone[]

  @@index([tenantId])
  @@index([connectionId])
  @@map("fiber_plans")
}

model PlanZone {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String
  plan        FiberPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String    @default("#6366F1") // hex, e.g. #6366F1
  createdAt   DateTime  @default(now()) @map("created_at")

  markers PlanMarker[]

  @@index([tenantId])
  @@index([planId])
  @@map("plan_zones")
}

model PlanMarker {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId     String?   @map("zone_id")
  zone       PlanZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  label      String
  deviceKind String?   @map("device_kind") // TopologyNodeKind values: OLT, PON_PORT, SPLITTER, CTO, ONU
  deviceId   String?   @map("device_id")
  xPercent   Float     @map("x_percent") // 0.0–100.0, resolution-independent
  yPercent   Float     @map("y_percent") // 0.0–100.0, resolution-independent
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([zoneId])
  @@index([deviceKind])
  @@index([deviceId])
  @@map("plan_markers")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOC/SOC AIOps: geographic zones, runbooks, change timeline
// ─────────────────────────────────────────────────────────────────────────────

model GeoZone {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  latitude    Float?
  longitude   Float?
  color       String   @default("#3B82F6")
  severity    String   @default("normal") // normal | degraded | critical
  deviceKind  String?
  deviceId    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([deviceKind, deviceId])
  @@map("geo_zones")
}

model Runbook {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  content          String    @db.Text
  deviceKind       String? // TopologyNodeKind — null = applies to all
  deviceId         String? // Specific device; null = applies to all devices of kind
  alertKind        String? // AlertKind — null = applies to all alert types
  severity         String? // AlertSeverity — null = applies to all severities
  // Link to ConfirmedIncident that generated this runbook
  sourceIncidentId String?   @map("source_incident_id")
  tags             String[]  @default([])
  stepCount        Int       @default(0) @map("step_count")
  lastUsedAt       DateTime? @map("last_used_at")
  useCount         Int       @default(0) @map("use_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([deviceKind, deviceId])
  @@index([alertKind, severity])
  @@map("runbooks")
}

model NotificationChannel {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            String // slack | webhook | email
  // Slack/webhook URL or user@host. Treated as a secret: always redacted in logs, API
  // responses and error messages — see redactSecrets() in @ftth-copilot/soc.
  target          String
  enabled         Boolean   @default(true)
  minSeverity     String    @default("warning") @map("min_severity") // info | warning | critical
  labels          String[]  @default([])
  // A repeat of the same dedupeKey inside this window is dropped, so a flapping link
  // does not page someone once per scrape.
  cooldownSeconds Int       @default(300) @map("cooldown_seconds")
  lastSentAt      DateTime? @map("last_sent_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@index([tenantId, enabled])
  @@map("notification_channels")
}

model NotificationDelivery {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId String              @map("channel_id")
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dedupeKey String              @map("dedupe_key")
  severity  String
  title     String
  ok        Boolean
  status    Int?
  error     String?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([dedupeKey, channelId])
  @@map("notification_deliveries")
}

model CorrelationWeight {
  id          String   @id @default(cuid())
  tenantId    String   @unique @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Named logistic coefficients, one per extracted feature. Stored as a map so adding
  // a feature does not need a migration; unknown keys are ignored by the scorer.
  weights     Json     @default("{}")
  // Number of labelled outcomes folded in so far; guards against trusting weights
  // trained on a handful of examples.
  sampleCount Int      @default(0) @map("sample_count")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("correlation_weights")
}

model CorrelationOutcome {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groupId     String   @map("group_id")
  // true = operator confirmed this grouping became a real incident.
  confirmed   Boolean
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  metricKey   String?  @map("metric_key")
  actor       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, windowStart])
  @@index([tenantId, groupId])
  @@map("correlation_outcomes")
}

model ChangeEvent {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Network events (from DeviceEvent category enum): maintenance, config_change, firmware_upgrade, power_event
  category              String
  deviceKind            String?
  deviceId              String?
  title                 String
  description           String?   @db.Text
  severity              String    @default("info") // info | warning | critical
  occurredAt            DateTime  @map("occurred_at")
  resolvedAt            DateTime? @map("resolved_at")
  // Auto-correlate with incidents that started within ±30min of this event
  correlatedIncidentIds String[]  @default([]) @map("correlated_incident_ids")
  actor                 String? // user/system identifier
  metadata              Json?     @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([occurredAt])
  @@index([deviceKind, deviceId])
  @@map("change_events")
}

// ─── Enterprise: Audit Log ──────────────────────────────────────────────────
// Every mutation that touches security-sensitive resources is recorded here.
// The actor is the userId when a human is involved, or "system" when a
// background job or external integration wrote the record.
model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId      String   @map("actor_id") // user.id | "system" | "<service-name>"
  actorEmail   String?  @map("actor_email") // denormalised for display
  actorRole    String?  @map("actor_role") // role at the time of the action
  // High-level category matching the left-nav sections.
  category     AuditCategory
  // Human-readable verb phrase; rendered directly in the UI.
  action       String   // "created connector", "promoted incident", "updated runbook"
  resourceType String   @map("resource_type") // "Connector", "Incident", "User", "NotificationChannel"
  resourceId   String   @map("resource_id") // primary key of the affected row (redacted: only type + id stored)
  outcome      AuditOutcome
  metadata     Json     @default("{}") // extra context; never contains credentials
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, category])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

enum AuditCategory {
  AUTH
  USER_MANAGEMENT
  INCIDENT
  MAINTENANCE
  CONNECTOR
  NETWORK
  NOTIFICATION
  CONFIGURATION
  AI
  SYSTEM
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// ─── Enterprise: On-Call Scheduling ─────────────────────────────────────────
// Lightweight on-call schedule model for NOC operations.
// Supports weekly rotation with primary/backup assignments.

model OnCallSchedule {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Schedule metadata
  name        String   // e.g., "Primary NOC", "Escalation Level 2"
  description String?  @db.Text

  // Rotation settings
  rotationType String  @default("weekly") // "weekly" | "daily" | "custom"
  startOfWeek  Int     @default(1)        @map("start_of_week") // 1=Monday, 7=Sunday

  // Active assignments (current schedule entries)
  primaryUserId   String?  @map("primary_user_id")
  backupUserId    String?  @map("backup_user_id")
  escalationUserId String?  @map("escalation_user_id")

  // Schedule entries for rotation
  entries OnCallEntry[]

  // Handoff settings
  handoffTime  String   @default("09:00") @map("handoff_time") // HH:mm in tenant timezone
  timezone     String   @default("UTC")

  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, enabled])
  @@map("on_call_schedules")
}

model OnCallEntry {
  id          String   @id @default(cuid())
  scheduleId  String   @map("schedule_id")
  schedule    OnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // Who is on-call (soft reference to User.id, no FK constraint)
  userId      String   @map("user_id")

  // Role in this entry
  role        String   @default("primary") // "primary" | "backup" | "escalation"

  // Time bounds (UTC)
  startUtc    DateTime @map("start_utc")
  endUtc      DateTime @map("end_utc")

  // Optional notes
  notes       String?  @db.Text

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([scheduleId, startUtc])
  @@index([userId, startUtc])
  @@map("on_call_entries")
}

/// Raw SNMP trap evidence, kept for forensics rather than for the dashboard.
///
/// Policy decisions, taken deliberately:
///   - Non-identifying varbinds are stored normalised and in plain text, because
///     they are what analysis actually reads.
///   - Identifying varbinds (MAC addresses, ONU serials) are personal data, so
///     they are encrypted at rest and dropped wholesale on tenant offboarding.
///   - `expiresAt` carries the retention boundary so a scheduled purge does not
///     need to re-derive it from a policy constant on every row.
model SnmpEvidence {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidenceId  String
  fingerprint String
  senderIp    String
  snmpVersion String
  pduType     String
  trapOid     String
  sysUpTime   Int?
  eventTime   DateTime?
  receivedAt  DateTime @default(now())
  expiresAt   DateTime

  /// Normalised, non-identifying varbind values.
  varbinds Json

  /// Identifying varbinds, AES-256-GCM with the KMS master key. Null when the
  /// trap carried none, which is the common case.
  identifyingVarsEncrypted String?

  @@unique([tenantId, evidenceId])
  @@index([tenantId, receivedAt])
  @@index([expiresAt])
  @@index([fingerprint])
  @@map("snmp_evidence")
}
